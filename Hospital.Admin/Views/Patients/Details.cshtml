@model Hospital.Domain.Models.Patient

@{
    ViewData["Title"] = "Patiëntdossier";
}

<div class="page-header">

    <div>
        <a asp-controller="Patients"
               asp-action="Index">
            ← Terug naar patiënten
        </a>

        <p class="text-muted mb-1 mt-3">
            Patiëntdossier
        </p>

        <h1>
            @Model.FullName
        </h1>

        <p class="text-muted">
            Patiëntnummer: @Model.Id
        </p>
    </div>

    @if (User.IsInRole("Administrator") ||
         User.IsInRole("Secretary"))
    {
        <div>
            <a class="action-link"
                   asp-controller="Patients"
                   asp-action="Edit"
                   asp-route-id="@Model.Id">
                Gegevens wijzigen
            </a>
        </div>
    }

</div>

@if (TempData["Success"] is string success)
{
    <div class="alert-success-custom"
         role="status">
        <strong>
            @success
        </strong>
    </div>
}

<section>

    <h2>
        Persoonsgegevens
    </h2>

    <dl>
        <dt>
            Geboortedatum
        </dt>

        <dd>
            @Model.DateOfBirth.ToString("dd-MM-yyyy")
        </dd>

        <dt>
            E-mailadres
        </dt>

        <dd>
            @Model.Email
        </dd>

        <dt>
            Telefoonnummer
        </dt>

        <dd>
            @Model.PhoneNumber
        </dd>

        <dt>
            Adres
        </dt>

        <dd>
            @Model.Address
        </dd>
    </dl>

</section>

<section>

    <h2>
        Dossieronderdelen
    </h2>

    <p>
        Kies het onderdeel dat je wilt bekijken of beheren.
    </p>

    <div class="dossier-grid">

        <a class="dossier-card"
               asp-controller="Treatments"
               asp-action="Index"
               asp-route-patientId="@Model.Id">

            <strong>
                Behandelingen
            </strong>

            <span>
                Bekijk actieve en afgeronde behandelingen
                en het gekoppelde zorgteam.
            </span>

        </a>

        <a class="dossier-card"
               asp-controller="Consultations"
               asp-action="Index"
               asp-route-patientId="@Model.Id">

            <strong>
                Consultaties
            </strong>

            <span>
                Bekijk geplande en eerdere consultaties.
            </span>

        </a>

        <a class="dossier-card"
               asp-controller="Operations"
               asp-action="Index"
               asp-route-patientId="@Model.Id">

            <strong>
                Operaties
            </strong>

            <span>
                Bekijk geplande en eerdere operaties.
            </span>

        </a>

        <a class="dossier-card"
               asp-controller="Evaluations"
               asp-action="Index"
               asp-route-patientId="@Model.Id">

            <strong>
                Evaluaties
            </strong>

            <span>
                Bekijk geregistreerde evaluaties
                binnen het patiëntdossier.
            </span>

        </a>

        <a class="dossier-card"
               asp-controller="Documents"
               asp-action="Index"
               asp-route-patientId="@Model.Id">

            <strong>
                Documenten
            </strong>

            <span>
                Bekijk documenten die aan het
                patiëntdossier zijn toegevoegd.
            </span>

        </a>

    </div>

</section>