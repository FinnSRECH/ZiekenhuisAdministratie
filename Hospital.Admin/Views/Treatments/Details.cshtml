@model Hospital.Domain.Models.Treatment
@using Hospital.Domain.Models
@using Hospital.Domain.Enums

@{
    ViewData["Title"] = "Behandeling";

    var patient =
        ViewBag.Patient as Patient;
}

<a asp-controller="Treatments"
       asp-action="Index"
       asp-route-patientId="@Model.PatientId">
    ← Terug naar behandelingen
</a>

<h1>@Model.Name</h1>

@if (TempData["Success"] is string success)
{
    <div>
        <strong>@success</strong>
    </div>
}

@if (TempData["Error"] is string error)
{
    <div>
        <strong>@error</strong>
    </div>
}

@if (patient is not null)
{
    <p>
        Patiënt:
        <strong>@patient.FullName</strong>
    </p>
}

<h2>Behandelgegevens</h2>

<dl>
    <dt>Omschrijving</dt>
    <dd>@Model.Description</dd>

    <dt>Startdatum</dt>
    <dd>@Model.StartDate.ToString("dd-MM-yyyy")</dd>

    <dt>Status</dt>
    <dd>@Model.Status</dd>
</dl>

@if (Model.Status == TreatmentStatus.Active &&
     (User.IsInRole("Administrator") ||
      User.IsInRole("Secretary")))
{
    <h2>Behandeling afsluiten</h2>

    <p>
        Hiermee wordt de behandeling als afgerond gemarkeerd.
    </p>

    <form asp-controller="Treatments"
          asp-action="Complete"
          asp-route-id="@Model.Id"
          method="post">

        @Html.AntiForgeryToken()

        <button type="submit"
                onclick="return confirm('Weet je zeker dat je deze behandeling wilt afsluiten?');">
            Behandeling afsluiten
        </button>
    </form>
}