@{
    var controller =
        ViewContext.RouteData.Values["controller"]?.ToString();

    var isAuthenticated =
        User.Identity?.IsAuthenticated == true;

    var isAdministrator =
        User.IsInRole("Administrator");

    var canManage =
        User.IsInRole("Administrator") ||
        User.IsInRole("Secretary");
}

<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Hospital Admin
    </title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/Hospital.Admin.styles.css"
          asp-append-version="true" />
</head>

<body>

    <header class="app-header">
        <nav class="navbar navbar-expand-lg">

            <div class="container">

                <a class="navbar-brand app-brand"
                       asp-controller="Home"
                       asp-action="Index">

                    <span class="brand-mark">
                        H+
                    </span>

                    <span>
                        Hospital Admin
                    </span>
                </a>

                @if (isAuthenticated)
                {
                    <button class="navbar-toggler"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#mainNavigation"
                            aria-controls="mainNavigation"
                            aria-expanded="false"
                            aria-label="Navigatie openen">

                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse"
                         id="mainNavigation">

                        <ul class="navbar-nav me-auto app-navigation">

                            <li class="nav-item">
                                <a class="nav-link @(controller == "Home" ? "active" : "")"
                                       asp-controller="Home"
                                       asp-action="Index">
                                    Dashboard
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link @(controller == "Patients" ? "active" : "")"
                                       asp-controller="Patients"
                                       asp-action="Index">
                                    Patiënten
                                </a>
                            </li>

                            <li class="nav-item dropdown">

                                <a class="nav-link dropdown-toggle @(controller == "Consultations" || controller == "Operations" ? "active" : "")"
                                       href="#"
                                       role="button"
                                       data-bs-toggle="dropdown"
                                       aria-expanded="false">
                                    Planning
                                </a>

                                <ul class="dropdown-menu">

                                    <li>
                                        <a class="dropdown-item"
                                               asp-controller="Consultations"
                                               asp-action="Planning">
                                            Consultaties
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                               asp-controller="Operations"
                                               asp-action="Planning">
                                            Operaties
                                        </a>
                                    </li>

                                </ul>
                            </li>

                            @if (canManage)
                            {
                                <li class="nav-item dropdown">

                                    <a class="nav-link dropdown-toggle @(controller == "Staff" || controller == "OperatingRooms" || controller == "AuditLogs" ? "active" : "")"
                                           href="#"
                                           role="button"
                                           data-bs-toggle="dropdown"
                                           aria-expanded="false">
                                        Beheer
                                    </a>

                                    <ul class="dropdown-menu">

                                        <li>
                                            <a class="dropdown-item"
                                                   asp-controller="Staff"
                                                   asp-action="Index">
                                                Medewerkers
                                            </a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item"
                                                   asp-controller="OperatingRooms"
                                                   asp-action="Index">
                                                Operatiekamers
                                            </a>
                                        </li>

                                        @if (isAdministrator)
                                        {
                                            <li>
                                                <hr class="dropdown-divider" />
                                            </li>

                                            <li>
                                                <a class="dropdown-item"
                                                       asp-controller="AuditLogs"
                                                       asp-action="Index">
                                                    Auditlog
                                                </a>
                                            </li>
                                        }

                                    </ul>
                                </li>
                            }

                        </ul>

                        <div class="navbar-user">

                            <div class="user-information">

                                <span class="user-label">
                                    Ingelogd als
                                </span>

                                <strong>
                                    @User.Identity?.Name
                                </strong>

                            </div>

                            <a class="btn btn-outline-light btn-sm"
                                   asp-controller="Account"
                                   asp-action="Logout">
                                Uitloggen
                            </a>

                        </div>

                    </div>
                }

            </div>

        </nav>
    </header>

    <main class="app-main">

        <div class="container">
            @RenderBody()
        </div>

    </main>

    <footer class="app-footer">

        <div class="container">

            <span>
                Hospital Admin
            </span>

            <span>
                Administratieve ziekenhuisomgeving
            </span>

        </div>

    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync(
        "Scripts",
        required: false)

</body>
</html>