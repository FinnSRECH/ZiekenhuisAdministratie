@{
    ViewData["Title"] = "Wachtwoord vergeten";
}

<section class="login-shell">

    <div class="login-card">

        <div class="login-card-header">

            <span class="login-eyebrow">
                Account herstellen
            </span>

            <h1>
                Wachtwoord vergeten?
            </h1>

            <p>
                Om medische gegevens goed te beveiligen worden
                wachtwoorden niet automatisch via deze toepassing hersteld.
            </p>

        </div>

        <div class="content-card">

            <h2 class="mt-0">
                Neem contact op met de administrator
            </h2>

            <p>
                Vraag de administrator om je medewerkersaccount te controleren
                en indien nodig je toegang te herstellen.
            </p>

            <p class="mb-0">
                Vermeld daarbij je naam en je zakelijke e-mailadres.
            </p>

        </div>

        <div class="mt-4">

            <a class="btn btn-primary"
                   asp-controller="Account"
                   asp-action="Login">
                Terug naar inloggen
            </a>

        </div>

    </div>

</section>